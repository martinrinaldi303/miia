# ============================================================================
# .env.example — PLANTILLA de configuración de MIIA
# ----------------------------------------------------------------------------
# Copiá este archivo a  operador/aprendizaje/config/.env  y completá los
# valores REALES. El .env real está gitignored (tiene secretos) — este ejemplo
# no, así que NUNCA pongas una clave de verdad acá.
#
#   cp operador/aprendizaje/config/.env.example operador/aprendizaje/config/.env
#
# Lo leen: class38.js (lo carga dentro del proceso del orquestador y se lo pasa
# a cada hijo), miia_chatbot.py y class44.py. Las variables marcadas [REQUERIDO]
# tienen que estar o el sistema no arranca (o arranca degradado). El resto tiene
# un default sensato en el código.
# ============================================================================

# ── Base de datos (MySQL 8) ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miia_cognitiva
DB_USER=miia
DB_PASS=                      # [REQUERIDO] clave del usuario de la base
DB_ROOT_PASS=                 # solo la usa el deploy para crear la base/usuario
# MYSQL_BIN_DIR=              # [Windows] carpeta bin de MySQL si no está en PATH

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Puertos y bind ─────────────────────────────────────────────────────────
PORT=8443                     # class30: gateway HTTPS/WS — ÚNICA entrada pública
PY_PORT=5005                  # miia_chatbot.py (FastAPI) — loopback
PYTHON_SERVER=http://127.0.0.1:5005
DASH_PORT=3001                # class46 dashboard Socket.IO — loopback
UI_PORT=8088                  # UI del orquestador — loopback
MIIA_BIND=127.0.0.1           # el Python escucha SOLO loopback (class30 proxea)

# ── Dominio / web pública ──────────────────────────────────────────────────
MIIA_ENV=production
PUBLIC_BASE_URL=https://miiaia.com
OAUTH_BASE_URL=https://miiaia.com
OAUTH_CALLBACK=https://miiaia.com         # debe coincidir con Google Console
CORS_ORIGINS=https://miiaia.com
MIIA_ORIGENES_WS=https://miiaia.com       # allowlist de Origin para WebSocket
# Rangos de proxy en los que SÍ se cree el X-Forwarded-For (Cloudflare).
# Vacío = usa la lista interna de Cloudflare de seguridad_red.js.
MIIA_PROXIES_CONFIABLES=

# ── Seguridad / auth ───────────────────────────────────────────────────────
JWT_SECRET=                   # [REQUERIDO] mínimo 32 caracteres o el proceso NO arranca
JWT_TTL=7d
ADMIN_MASTER_EMAIL=admin@example.com
ADMIN_PASSWORD=               # clave del panel admin del Python

# ── OAuth Google (login) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Datos de mercado (precios) ─────────────────────────────────────────────
# El orden de fallback lo decide class7. Con el universo de 50, el tope de cuota
# vive en config/universo.json (llamadas_por_minuto). Finnhub gratis = 60/min.
FINNHUB_KEY=
ALPHAVANTAGE_KEY=
POLYGON_KEY=
TWELVEDATA_KEY=

# ── Noticias ───────────────────────────────────────────────────────────────
NEWSAPI_KEY=
BING_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_CX=

# ── Motor de lenguaje (Gemini + Ollama local) ──────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SOLO_USUARIO=1         # el LLM solo se usa en el CHAT, no en decisiones
MIIA_LLM=local                # local | auto | gemini  (local = solo Ollama)
MIIA_LLM_MODELO=gemma2:2b
OLLAMA_URL=http://127.0.0.1:11434
# Afinado del chat local (opcional, defaults medidos en class25B/llm_local.js):
# MIIA_LLM_MAX_TOKENS=90
# MIIA_LLM_TIMEOUT_MS=18000
# MIIA_LLM_TURNOS=2
# MIIA_LLM_CTX=2048
# MIIA_LLM_KEEPALIVE=5m

# ── Pagos (Mercado Pago) — hoy el cobro está PAUSADO ───────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=            # si está vacío, el webhook se rechaza (seguro)
MP_CURRENCY=ARS
MP_PRECIO_MENSUAL=
MP_PRECIO_ANUAL=

# ── Python runtime ─────────────────────────────────────────────────────────
# Ruta al intérprete del venv; el deploy la completa. Si está vacío, el
# orquestador usa MIIA/venv y después el Python del sistema.
# PYTHON_BIN=/opt/miia/MIIA/venv/bin/python
LOG_LEVEL=info

# ── class25A: auto-neutro (del corte de ORDEN 6) ───────────────────────────
# Dejar AMBAS para que el neutro se aplique y no se coma las 72h del arranque.
CLASS25A_APLICAR_NEUTRO=1
CLASS25A_AUTO_NEUTRO_H=12
